{
  "name": "nai-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3100",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3100",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build:behaviour": "node scripts/build-behaviour.mjs",
    "fetch:danbooru": "curl -fsSL -o data/danbooru.csv https://raw.githubusercontent.com/DominikDoom/a1111-sd-webui-tagcomplete/main/tags/danbooru.csv",
    "tagger": "cd ../tagger && uv run uvicorn tagger:app --host 127.0.0.1 --port 8190",
    "captioner": "llama-server -m ~/models/toriigate/ToriiGate-0.5-Q4_K_M.gguf --mmproj ~/models/toriigate/ToriiGate-0.5-Q8_0.mmproj.gguf --host 127.0.0.1 --port 8191 -c 8192 -ngl 99",
    "tipo": "llama-server -m ~/models/tipo/gguf/TIPO-v2.1-1B-A200M-Q8_0.gguf --host 127.0.0.1 --port 8193 -c 2048 -ngl 99",
    "up": "bash scripts/power.sh up",
    "down": "bash scripts/power.sh down",
    "status": "bash scripts/power.sh status",
    "deploy": "npm run build && launchctl kickstart -k gui/$(id -u)/com.philly95.naistudio"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.3",
    "next": "16.2.7",
    "png-chunk-text": "^1.0.0",
    "png-chunks-encode": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
