# NovelAI persistent API token (novelai.net → Account Settings → Get Persistent API Token)
NOVELAI_TOKEN=

# Password gate — set both before exposing over Tailscale.
# SESSION_SECRET: generate with  openssl rand -hex 32
APP_PASSWORD=
SESSION_SECRET=

# Optional: repo root holding tags/ and data/ (defaults to the parent of studio/)
# REPO_DIR=

# Co-pilot backends (defaults shown)
# OLLAMA_URL=http://127.0.0.1:11434
# BRAIN_MODEL=hf.co/HauhauCS/Gemma4-12B-QAT-Uncensored-HauhauCS-Balanced:Q4_K_M
# CAPTION_URL=http://127.0.0.1:8191
# TIPO_URL=http://127.0.0.1:8193

# Optional Danbooru account for Find (anonymous search allows 2 tags)
# DANBOORU_LOGIN=
# DANBOORU_API_KEY=
